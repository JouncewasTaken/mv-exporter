# ── mv-exporter .env template ──
# Copy to `.env` (which mv_exporter.py auto-loads via _load_dotenv) and fill in.
# `.env` is gitignored; THIS `.env.example` (placeholders only) is the committed
# reference. No shell sourcing needed — the exporter reads .env itself, and real
# shell env overrides file values (setdefault semantics).

# --- Multiview tenant + auth ---
# URL is built as https://<MV_SUBDOMAIN>.multiviewcorp.net — subdomain only, never the full URL.
MV_SUBDOMAIN=CHANGE_ME
MV_USER=CHANGE_ME
MV_PASS=CHANGE_ME

# --- Paths: keep BOTH outside the git working tree (e.g. /srv/mv/...) ---
MV_EXPORT_DIR=/srv/mv/exports
MV_LANDING_DB=/srv/mv/mv_landing.db

# --- Politeness throttle between requests (seconds); default 1.0 if unset ---
MV_THROTTLE_S=1.0

# Module + headless are CLI flags, not env:
#   --form-url AP|GL|AR (or full form URL)   selects the module
#   --no-headless                            for the MFA/SSO login window
