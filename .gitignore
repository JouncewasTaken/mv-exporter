# ── mv-exporter .gitignore ──
# Public repo + real financial/PHI extraction on the dev box => treat every
# tracked path as world-readable. Data and secrets must never leave the box.

# --- SQLite landing DB + WAL sidecars (sidecars hold live un-checkpointed pages) ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
db/
extracts/

# --- Secrets / credentials (the real file is gitignored; the .example is committed) ---
credentials.env
.env
*.env
!*.env.example

# --- Selenium leak vectors: failure screenshots render the live PHI page; driver logs ---
screenshots/
*.png
geckodriver.log
chromedriver.log
*.log
logs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- Editors / OS (repo lives on a Mac-formatted drive + GitHub Desktop on macOS) ---
.DS_Store
Thumbs.db
.idea/
.vscode/